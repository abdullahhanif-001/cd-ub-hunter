# CD-UB Contabo ephemeral / wipe flags
# STRICT: do NOT wipe VPS until user explicitly orders it.
AUTO_WIPE=0
CONFIRM_USER_WIPE=0
WIPE_REASON=
EPHEMERAL_CAPABLE=1

CDUB_ROOT=/opt/cd-ub
CDUB_INCOMING=/opt/cd-ub-incoming
CDUB_PROFILE=speed-2

# Resource gates (from live Contabo check)
DISK_AVAIL_MIN_G=40
MEM_AVAIL_MIN_G=3.5
CPU_QUOTA_PCT=50
MEMORY_MAX=2.5G
CPU_AFFINITY=2-3
NICE_LEVEL=5

# AFL / corpus
export AFL_NO_AFFINITY=1
export AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES=1
CORPUS_MAX_MB=2048
SINGLE_CAMPAIGN=1

# CompDiff vendor pin
COMPDIFF_PIN=2b2cdd3fa31f83c9a9e4070c2131d156c3dfcad4
